{
  "name": "dopefolio",
  "version": "1.0.1",
  "author": "Bullettime23",
  "description": "",
  "main": "index.js",
  "type": "module",
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@splidejs/splide": "^4.1.4",
    "alpinejs": "^3.15.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "autoprefixer": "^10.4.27",
    "postcss-cli": "^11.0.1",
    "sass": "^1.98.0",
    "typescript": "^5.9.3"
  },
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "compile:scss": "sass sass/main.scss css/style.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.css -o css/style.css",
    "compress:css": "sass --style=compressed css/style.css css/style.css",
    "build": "bun run compile:scss && bun run prefix:css compress:css"
  }
}