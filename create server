--------------------------------------------------
-- TAB SWITCHING
--------------------------------------------------
local function switchTab(tab)
	if tab == "create" then
		createFrame.Visible = true
		linkFrame.Visible = false
		tabCreate.BackgroundColor3 = Color3.fromRGB(80, 60, 180)
		tabLink.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	elseif tab == "link" then
		createFrame.Visible = false
		linkFrame.Visible = true
		tabCreate.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
		tabLink.BackgroundColor3 = Color3.fromRGB(80, 60, 180)
	end
end

tabCreate.MouseButton1Click:Connect(function()
	switchTab("create")
end)

tabLink.MouseButton1Click:Connect(function()
	switchTab("link")
end)

closeBtn.MouseButton1Click:Connect(function()
	gui:Destroy()
end)
