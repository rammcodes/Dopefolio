local createCorner = Instance.new("UICorner")
createCorner.CornerRadius = UDim.new(0, 10)
createCorner.Parent = createBtn

-- Click to change and auto reset after 3 seconds
createBtn.MouseButton1Click:Connect(function()
	if createBtn.Text == "CREATE" then
		createBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
		createBtn.Text = "SUCCESS"
		task.delay(3, function()
			if createBtn and createBtn.Parent then
				createBtn.BackgroundColor3 = Color3.fromRGB(120, 60, 200)
				createBtn.Text = "CREATE"
			end
		end)
	end
end)

